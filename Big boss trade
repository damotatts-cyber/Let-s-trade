import { useTransition } from 'react'; // React 20 optimization

export default function GlobalShipper() {
  const [isPending, startTransition] = useTransition();

  const shipMoney = (formData: FormData) => {
    startTransition(async () => {
      // DIT Logic: Phone number becomes the routing address
      await fetch('/api/bridge', {
        method: 'POST',
        body: JSON.stringify({
          phone: formData.get('phone'),
          amount: formData.get('amount'),
          asset: 'BTC_TO_CASH'
        })
      });
    });
  };

  return (
    <form action={shipMoney} className="p-4 bg-zinc-800 rounded-xl shadow-2xl">
      <input name="phone" placeholder="+1 Phone Number" className="w-full mb-2 p-2 bg-black text-white" />
      <input name="amount" placeholder="Amount to Ship" className="w-full mb-2 p-2 bg-black text-white" />
      <button disabled={isPending} className="w-full py-3 bg-blue-600 text-white font-bold rounded-lg">
        {isPending ? 'SHIPPING AT SPEED...' : 'SHIP CASH INSTANTLY'}
      </button>
    </form>
  );
