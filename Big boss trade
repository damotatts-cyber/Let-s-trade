  // DIT Power: No login required if biometric touch is detected
  const { balance } = useTokenBalance(); 

  const handleInstantCashOut = async (amount, coin) => {
    'use server';
    // The "Power Move": Swap & Pay happens in 10 seconds
    const transaction = await DIT_Bridge.execute({
      from: coin,
      to: 'USD_REAL_MONEY',
      destination: 'USER_DEBIT_CARD',
      instant: true
    });
    
    if(transaction.success) notify("Money is in your bank account now.");
  };

  return (
    <div className="flex flex-col gap-4 p-6 bg-zinc-900 rounded-3xl">
      <h2 className="text-white text-2xl">Your Assets</h2>
      <BalanceDisplay value={balance} />
