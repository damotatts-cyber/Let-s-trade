# Optional: enable Prisma persistence with a local SQLite database.
DATABASE_URL="file:./prisma/dev.db"

# Recommended for any shared or non-local environment.
SESSION_SECRET=""

# Set to true only for explicit local-only mock login when SESSION_SECRET is unset.
GUARDRAIL_ALLOW_INSECURE_DEV_SESSION="true"

# Optional: require a bearer token for gateway POSTs.
GUARDRAIL_SHARED_TOKEN=""

# Adapter boundaries only. When absent, local detector heuristics remain authoritative.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
